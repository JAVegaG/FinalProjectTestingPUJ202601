# Normalize text files to LF across macOS, Linux, and Windows.
* text=auto eol=lf

# Windows scripts should keep CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts should keep LF line endings.
*.sh text eol=lf
gradlew text eol=lf

# Source, config, and documentation files.
*.java text eol=lf
*.feature text eol=lf
*.js text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gitignore text eol=lf

# Binary files should never be line-ending normalized.
*.jar binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
